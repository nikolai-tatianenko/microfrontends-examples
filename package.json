{
  "name": "microfrontends-examples",
  "private": true,
  "version": "1.0.0",
  "description": "Runtime-composed microfrontends: React 19 shell, React + Vue 3 remotes, typed mount contract, shared design system.",
  "license": "MIT",
  "author": "Nikolai Tatianenko",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@vanilla/* --concurrency=12",
    "dev:portless": "node scripts/portless.mjs dev",
    "ui:portless": "node scripts/portless.mjs ui",
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "e2e": "PLAYWRIGHT_JSON_OUTPUT_FILE=reports/e2e/results.json playwright test --project=chromium",
    "visual": "pnpm --filter @blog/ui build-storybook && PLAYWRIGHT_JSON_OUTPUT_FILE=reports/visual/results.json playwright test --project=visual",
    "visual:update": "node scripts/visual-docker.mjs --update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @blog/ui storybook",
    "test:ci-scripts": "node --test \"scripts/*.test.mjs\" \"scripts/ci/*.test.mjs\"",
    "visual:docker": "node scripts/visual-docker.mjs",
    "coverage:check": "node scripts/coverage-gate.mjs",
    "test:all": "turbo run test test:integration",
    "prepare": "husky",
    "commit": "cz",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.35.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@playwright/test": "^1.55.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.1.0",
    "jest-environment-jsdom": "^30.1.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.43.0",
    "vue-tsc": "^3.0.6"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,vue}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}

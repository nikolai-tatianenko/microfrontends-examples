{
  "$description": "Design tokens in the W3C Design Tokens Community Group format. The single source of truth: `pnpm tokens:build` turns it into CSS custom properties and a typed object, and nothing else in the repo may hard-code a color.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "#ffffff",
        "$description": "Page background.",
        "$extensions": {
          "com.blog.mode": { "dark": "#121212" },
          "com.blog.forced": "Canvas"
        }
      },
      "raised": {
        "$value": "#ffffff",
        "$description": "Cards, dialogs and other surfaces that sit above the page.",
        "$extensions": {
          "com.blog.mode": { "dark": "#1e1e1e" },
          "com.blog.forced": "Canvas"
        }
      },
      "muted": {
        "$value": "#f5f5f5",
        "$description": "Quiet panels and secondary buttons.",
        "$extensions": {
          "com.blog.mode": { "dark": "#2a2a2a" },
          "com.blog.forced": "Canvas"
        }
      }
    },
    "text": {
      "default": {
        "$value": "#171717",
        "$description": "Body text.",
        "$extensions": {
          "com.blog.mode": { "dark": "#fafafa" },
          "com.blog.forced": "CanvasText"
        }
      },
      "muted": {
        "$value": "#4d4d4d",
        "$description": "Secondary text. 7:1 on every surface.",
        "$extensions": {
          "com.blog.mode": { "dark": "#b8bdc2" },
          "com.blog.forced": "CanvasText"
        }
      },
      "onPrimary": {
        "$value": "#ffffff",
        "$description": "Text on a primary-colored surface.",
        "$extensions": {
          "com.blog.mode": { "dark": "#0a0a0a" },
          "com.blog.forced": "HighlightText"
        }
      }
    },
    "border": {
      "default": {
        "$value": "#e0e0e0",
        "$description": "Hairlines between regions. Decorative: nothing relies on it to be understood.",
        "$extensions": {
          "com.blog.mode": { "dark": "#333333" },
          "com.blog.forced": "CanvasText"
        }
      }
    },
    "primary": {
      "default": {
        "$value": "#0d47a1",
        "$description": "Brand color for actions and links.",
        "$extensions": {
          "com.blog.mode": { "dark": "#90caf9" },
          "com.blog.forced": "Highlight"
        }
      }
    },
    "focus": {
      "$value": "{color.primary.default}",
      "$description": "Keyboard focus ring.",
      "$extensions": { "com.blog.forced": "Highlight" }
    },
    "positive": {
      "$value": "#14612c",
      "$description": "Success text and indicators.",
      "$extensions": {
        "com.blog.mode": { "dark": "#81c784" },
        "com.blog.forced": "CanvasText"
      }
    },
    "negative": {
      "$value": "#a31515",
      "$description": "Errors and destructive actions.",
      "$extensions": {
        "com.blog.mode": { "dark": "#ff8a80" },
        "com.blog.forced": "CanvasText"
      }
    },
    "owner": {
      "$description": "Labels of the 'Show micro-apps' overlay. White text sits on each at 7:1 in both modes.",
      "shell": { "$value": "#37474f" },
      "marketing": { "$value": "#0d47a1" },
      "auth": { "$value": "#6a1b9a" },
      "dashboard": { "$value": "#1b5e20" },
      "landing": { "$value": "#92400e" },
      "text": { "$value": "#ffffff" }
    },
    "brand": {
      "$description": "The four tiles of the logo mark.",
      "blue": { "$value": "#1565c0" },
      "green": { "$value": "#2e7d32" },
      "orange": { "$value": "#ef6c00" },
      "purple": { "$value": "#6a1b9a" }
    },
    "glow": {
      "$description": "Translucent washes behind the landing hero.",
      "blue": { "$value": "#3b82f624" },
      "green": { "$value": "#34b45a1a" },
      "orange": { "$value": "#f39a331a" }
    },
    "scrim": {
      "$value": "#00000099",
      "$description": "Dimmed backdrop behind the guided tour."
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" }
  },
  "size": {
    "$type": "dimension",
    "target": {
      "$value": "44px",
      "$description": "Minimum pointer target, WCAG 2.5.5 (AAA)."
    },
    "focusRing": {
      "$value": "3px",
      "$description": "Focus ring thickness, WCAG 2.4.13 (AAA)."
    },
    "focusOffset": { "$value": "2px" }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      }
    }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": "150ms" },
    "base": { "$value": "250ms" }
  }
}
